# Copy to .env and adjust.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_booking"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_booking_test"
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
SEAT_HOLD_TTL_MS=600000
WAITLIST_OFFER_TTL_MS=600000
SCHEDULER_INTERVAL_MS=5000
EMAIL_TRANSPORT=log
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ticket Booking <tickets@example.com>"
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173