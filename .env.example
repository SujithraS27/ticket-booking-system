# ------------------------------------------------------------------
# Ticket Booking System - environment variables
# Copy this file to backend/.env (backend process) and adjust values.
# ------------------------------------------------------------------

# ---------- Database ----------
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_booking"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_booking_test"

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Authentication ----------
# Production must override this with a long random string.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- Seat hold & waitlist (configurable TTLs) ----------
# How long a selected seat is held before it auto-releases (ms).
# Default: 10 minutes (600000 ms).
SEAT_HOLD_TTL_MS=600000

# How long a waitlist offer link stays valid before it is offered to the next person (ms).
WAITLIST_OFFER_TTL_MS=600000

# How often the backend scheduler scans for expired holds / offers (ms).
SCHEDULER_INTERVAL_MS=5000

# ---------- Email ----------
# EMAIL_TRANSPORT: "log" streams emails to the console (default),
#                  "smtp" uses real SMTP (e.g. Ethereal or Gmail app password).
EMAIL_TRANSPORT=log
EMAIL_FROM="Ticket Booking <tickets@example.com>"
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-password

# ---------- Frontend ----------
# Public URL of the frontend (used in emails for waitlist offer links).
FRONTEND_URL=http://localhost:5173

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend (frontend/.env) ----------
# VITE_API_URL is used by the frontend. In development the Vite proxy
# forwards /api and /socket.io to the backend, so this may be empty.
# VITE_API_URL=